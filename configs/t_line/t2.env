# T line T2 (2026-09-22) render/eval environment.  Source it:  set -a; . configs/t_line/current.env; set +a
# The audio overlay is the re-decoded audio.wav (T1's is up to 161 ms early); STRIP_INGEST and
# INGEST must point at it or a render muxes the early sound under T2-timed motion.
STRIP_AUDIO=runs/txy_t2_gt_eval/audio
STRIP_GT_MOTION=runs/txy_t2_gt_eval/motion
STRIP_LABELS=data/wild3d/txy_t2_labels
STRIP_INGEST=/cache/atomicdance-assets/data/wild_ingest_txy_t2_audiofix
STRIP_CONVERTED=/cache/atomicdance-assets/data/wild3d/txy_t2_converted_20260922
INGEST=/cache/atomicdance-assets/data/wild_ingest_txy_t2_audiofix
T_RELEASE=/cache/atomicdance-assets/scratch/txy_t2/release_aligned_k8_20260922
T_EVAL_AUDIO=runs/txy_t2_gt_eval/audio
T_EVAL_MOTION=runs/txy_t2_gt_eval/motion
T_VAL_AUDIO=runs/txy_t2_gt_eval_val/audio
T_VAL_MOTION=runs/txy_t2_gt_eval_val/motion
